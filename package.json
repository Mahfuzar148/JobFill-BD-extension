{
  "name": "jobfill-bd",
  "version": "2.0.0",
  "description": "JobFill BD — Smart Bangladesh Government Job Application Assistant Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node build.js",
    "build:chrome-store": "node scripts/package-stores.mjs --target=chrome",
    "build:edge-store": "node scripts/package-stores.mjs --target=edge",
    "build:stores": "node scripts/package-stores.mjs --target=both",
    "validate:stores": "node scripts/package-stores.mjs --validate-only",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-check.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/chrome": "^0.0.312",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^5.1.0"
  }
}
